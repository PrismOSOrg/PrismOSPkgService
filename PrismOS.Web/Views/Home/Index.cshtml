@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-copy">
        <h1>Packages for <span>PrismOS.</span></h1>
        <p class="hero-description">
            A home for PrismOS packages. Browse the catalog or connect with the
            package-manager API.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" href="/catalog">Browse package catalog <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/healthz">Check API status</a>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <img src="~/images/logo.png" />
    </div>
</section>

<section class="content-section" aria-labelledby="getting-started">
    <div class="section-heading">
        <p class="eyebrow">GETTING STARTED</p>
        <h2 id="getting-started">Everything you need to connect.</h2>
    </div>
    <div class="info-grid">
        <article class="info-card">
            <span class="card-number">01</span>
            <h3>Explore packages</h3>
            <p>See the packages currently available in the repository catalog.</p>
            <a href="/catalog">Open catalog <span aria-hidden="true">→</span></a>
        </article>
        <article class="info-card">
            <span class="card-number">02</span>
            <h3>Connect your tools</h3>
            <p>The versioned HTTP API remains available for the PrismOS package manager.</p>
            <a href="/healthz">View service status <span aria-hidden="true">→</span></a>
        </article>
        <article class="info-card">
            <span class="card-number">03</span>
            <h3>Read the API docs</h3>
            <p>Explore the versioned endpoints and try requests from the interactive Swagger reference.</p>
            <a href="/swagger">Open API documentation <span aria-hidden="true">→</span></a>
        </article>
    </div>
</section>
